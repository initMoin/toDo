        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini mengalih keluar senarai dikongsi dan aksesnya untuk semua orang. Tindakan ini tidak boleh dibuat asal."
          }
        },
        "th" : {
          "stringUnit" : {

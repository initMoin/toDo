    "Name the shared space you want to use with other users." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سمِّ المساحة المشتركة التي تريد استخدامها مع مستخدمين آخرين."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon nombre al espacio compartido que quieres usar con otros usuarios."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उस साझा स्थान को नाम दें जिसे आप अन्य उपयोगकर्ताओं के साथ उपयोग करना चाहते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

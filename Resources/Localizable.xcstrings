        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google साइन-इन सुरक्षित ब्राउज़र सत्र नहीं खोल सका। फिर कोशिश करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

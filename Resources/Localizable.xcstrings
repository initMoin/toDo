            "value" : "उपयोगकर्ता नाम को %lld वर्णों या कम का रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni il nome utente entro %lld caratteri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザー名は%lld文字以内にしてください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hadkan nama pengguna kepada %lld aksara atau kurang."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้ชื่อผู้ใช้ไม่เกิน %lld ตัวอักษร"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنے صارف نام کو %lld حروف یا اس سے کم رکھیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

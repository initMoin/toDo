        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings mengawal penyegerakan, tingkah laku notifikasi, rupa dan sama ada toDō yang dibuang diarkibkan atau dipindahkan ke sampah."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings ควบคุมการซิงค์ พฤติกรรมการแจ้งเตือน รูปลักษณ์ และการลบ toDō ว่าจะเก็บถาวรหรือย้ายไปถังขยะ"
          }
        },
        "ur" : {
          "stringUnit" : {

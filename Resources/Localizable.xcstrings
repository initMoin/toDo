        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes revisar o rechazar esta invitación antes de unirte a la lista compartida."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "साझा सूची में शामिल होने से पहले आप इस निमंत्रण की समीक्षा या अस्वीकृति कर सकते हैं।"

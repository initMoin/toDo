    "Offline. Sync and online features are paused." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غير متصل. تم إيقاف المزامنة والميزات المتصلة بالإنترنت مؤقتًا."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin conexión. La sincronización y las funciones en línea están pausadas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑफ़लाइन। सिंक और ऑनलाइन सुविधाएं रुकी हुई हैं।"

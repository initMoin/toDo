    "iCloud profile images are unavailable on this device. Choose this device or all signed-in devices." : {
      "comment" : "Error message displayed when iCloud profile images are unavailable on the device.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صور iCloud الشخصية غير متاحة على هذا الجهاز. اختر هذا الجهاز أو كل الأجهزة التي سجّلت الدخول."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las imágenes de perfil de iCloud no están disponibles en este dispositivo. Elige este dispositivo o todos los dispositivos con sesión iniciada."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर iCloud प्रोफ़ाइल चित्र उपलब्ध नहीं हैं। यह डिवाइस या सभी साइन-इन किए गए डिवाइस चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le immagini del profilo iCloud non sono disponibili su questo dispositivo. Scegli questo dispositivo o tutti i dispositivi con accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスではiCloudプロフィール画像を利用できません。このデバイス、またはサインイン済みのすべてのデバイスを選択してください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gambar profil iCloud tidak tersedia pada peranti ini. Pilih peranti ini atau semua peranti yang dilog masuk."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รูปโปรไฟล์ iCloud ไม่พร้อมใช้งานบนอุปกรณ์นี้ เลือกอุปกรณ์นี้หรืออุปกรณ์ที่ลงชื่อเข้าใช้ทั้งหมด"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس ڈیوائس پر iCloud پروفائل تصاویر دستیاب نہیں۔ یہ ڈیوائس یا تمام سائن اِن آلات منتخب کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备无法使用 iCloud 头像。请选择此设备或所有已登录设备。"
          }
        }
      }
    },

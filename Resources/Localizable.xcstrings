    "This removes the shared list and its access for everyone. This cannot be undone." : {
      "comment" : "A confirmation alert for deleting a collaboration.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا إلى إزالة القائمة المشتركة ووصولها للجميع. لا يمكن التراجع عن ذلك."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina la lista compartida y su acceso para todos. No se puede deshacer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह साझा सूची और सभी के लिए उसकी पहुँच हटा देता है。 इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove la lista condivisa e il relativo accesso per tutti. Non può essere annullato."
          }

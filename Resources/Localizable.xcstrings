    "Stay local for this device, use iCloud across Apple devices, or sign in to use toDō Sync across iPhone, iPad, Watch, Mac, Android, and web." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابقَ محليًا على هذا الجهاز، أو استخدم iCloud عبر أجهزة Apple، أو سجّل الدخول لاستخدام toDō Sync عبر iPhone وiPad وWatch وMac وAndroid والويب."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quédate local en este dispositivo, usa iCloud entre dispositivos Apple o inicia sesión para usar toDō Sync en iPhone, iPad, Watch, Mac, Android y la web."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर स्थानीय रहें, Apple डिवाइसों पर iCloud इस्तेमाल करें, या iPhone, iPad, Watch, Mac, Android और वेब पर toDō Sync के लिए साइन इन करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta locale su questo dispositivo, usa iCloud sui dispositivi Apple oppure accedi per usare toDō Sync su iPhone, iPad, Watch, Mac, Android e web."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスだけでローカル保存するか、Appleデバイス間でiCloudを使うか、サインインしてiPhone、iPad、Watch、Mac、Android、WebでtoDō Syncを使えます。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kekal setempat pada peranti ini, gunakan iCloud merentas peranti Apple, atau daftar masuk untuk menggunakan toDō Sync pada iPhone, iPad, Watch, Mac, Android dan web."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บไว้เฉพาะอุปกรณ์นี้ ใช้ iCloud ข้ามอุปกรณ์ Apple หรือเข้าสู่ระบบเพื่อใช้ toDō Sync บน iPhone, iPad, Watch, Mac, Android และเว็บ"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس ڈیوائس پر مقامی رہیں، Apple ڈیوائسز پر iCloud استعمال کریں، یا iPhone، iPad، Watch، Mac، Android، اور ویب پر toDō Sync استعمال کرنے کے لیے سائن ان کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可在此设备本地保存，跨 Apple 设备使用 iCloud，或登录后在 iPhone、iPad、Watch、Mac、Android 和网页上使用 toDō Sync。"
          }
        }
      }
    },
    "Stay local for this device, use iCloud across Apple devices, or sign in to use toDō Sync across iPhone, iPad, Watch, Mac, Android, and web. Review this screen, then continue below." : {
      "comment" : "Text displayed in a GuidedOnboardingView when the user is choosing how to keep their toDōs.",
      "isCommentAutoGenerated" : true
    },
    "Stay local for this device, use iCloud across Apple devices, or sign in to use toDō Sync across iPhone, iPad, Watch, Mac, Android, and web. Review this screen, then use the back arrow to return to the tour or continue below." : {
      "comment" : "Text displayed in a GuidedOnboardingView when the user is choosing how to keep their toDōs.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابقَ محليًا لهذا الجهاز، أو استخدم iCloud عبر أجهزة Apple، أو سجّل الدخول لاستخدام toDō Sync على iPhone وiPad وWatch وMac وAndroid والويب. راجع هذه الشاشة، ثم استخدم سهم الرجوع للعودة إلى الجولة أو تابع أدناه."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén los datos locales en este dispositivo, usa iCloud entre dispositivos Apple o inicia sesión para usar toDō Sync en iPhone, iPad, Watch, Mac, Android y la web. Revisa esta pantalla y usa la flecha atrás para volver al recorrido o continuar abajo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस डिवाइस पर स्थानीय रूप से रहें, Apple डिवाइसों में iCloud का उपयोग करें, या iPhone, iPad, Watch, Mac, Android और वेब पर toDō Sync उपयोग करने के लिए साइन इन करें। इस स्क्रीन की समीक्षा करें, फिर टूर पर लौटने के लिए पीछे तीर का उपयोग करें या नीचे जारी रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta locale su questo dispositivo, usa iCloud tra i dispositivi Apple oppure accedi per usare toDō Sync su iPhone, iPad, Watch, Mac, Android e web. Esamina questa schermata, poi usa la freccia indietro per tornare al tour o continua qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスだけでローカルに使うか、Appleデバイス間でiCloudを使うか、サインインしてiPhone、iPad、Watch、Mac、Android、WebでtoDō Syncを使えます。この画面を確認し、戻る矢印でツアーに戻るか、下へ進みます。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kekalkan setempat untuk peranti ini, gunakan iCloud merentas peranti Apple, atau log masuk untuk menggunakan toDō Sync pada iPhone, iPad, Watch, Mac, Android dan web. Semak skrin ini, kemudian gunakan anak panah kembali untuk kembali ke lawatan atau teruskan di bawah."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้แบบเฉพาะอุปกรณ์นี้ ใช้ iCloud ระหว่างอุปกรณ์ Apple หรือลงชื่อเข้าใช้เพื่อใช้ toDō Sync บน iPhone, iPad, Watch, Mac, Android และเว็บ ตรวจสอบหน้าจอนี้ แล้วใช้ลูกศรย้อนกลับเพื่อกลับไปที่ทัวร์หรือดำเนินการต่อด้านล่าง"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس ڈیوائس کے لیے مقامی رہیں، Apple آلات پر iCloud استعمال کریں، یا iPhone، iPad، Watch، Mac، Android اور ویب پر toDō Sync استعمال کرنے کے لیے سائن اِن کریں۔ اس اسکرین کا جائزہ لیں، پھر ٹور پر واپس جانے کے لیے پیچھے کا تیر استعمال کریں یا نیچے جاری رکھیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在此设备本地使用，或在 Apple 设备之间使用 iCloud；也可以登录后在 iPhone、iPad、Watch、Mac、Android 和 Web 上使用 toDō Sync。查看此页面，然后使用返回箭头返回引导，或继续向下。"
          }
        }
      }
    },
    "Stop adding due toDōs to Calendar?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاف إضافة مهام toDō المستحقة إلى التقويم؟"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Dejar de añadir toDōs con vencimiento a Calendario?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "देय toDō को Calendar में जोड़ना बंद करें?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smettere di aggiungere i toDō in scadenza a Calendario?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期限付きtoDōのカレンダーへの追加を停止しますか？"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berhenti menambah toDō bertarikh tamat ke Kalendar?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หยุดเพิ่ม toDō ที่มีกำหนดลงในปฏิทินหรือไม่"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واجب الادا toDō کو Calendar میں شامل کرنا بند کریں؟"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止将有到期日期的 toDō 添加到日历？"
          }
        }
      }
    },
    "Stop listening" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {

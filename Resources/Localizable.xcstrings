    "%@ overdue toDōs are creating the clearest pressure. Resolve or reschedule one before adding more." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُشكّل %@ من مهام toDō المتأخرة الضغط الأوضح. أنجز واحدة أو أعد جدولتها قبل إضافة المزيد."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ toDōs vencidos están creando la presión más clara. Resuelve o reprograma uno antes de añadir más."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ समय-सीमा पार toDō सबसे स्पष्ट दबाव बना रहे हैं। और जोड़ने से पहले किसी एक को पूरा करें या फिर से तय करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ toDō scaduti stanno creando la pressione più evidente. Completane o riprogrammane uno prima di aggiungerne altri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期限切れのtoDōが%@件あり、最も大きな負担になっています。追加する前に1件完了するか、予定を変更しましょう。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ toDō tertunggak memberi tekanan paling jelas. Selesaikan atau jadualkan semula satu sebelum menambah lagi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "toDō ที่เกินกำหนด %@ รายการกำลังสร้างแรงกดดันชัดเจนที่สุด จัดการหรือเลื่อนกำหนดหนึ่งรายการก่อนเพิ่มงานอีก"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ زائد المیعاد toDō سب سے واضح دباؤ پیدا کر رہے ہیں۔ مزید شامل کرنے سے پہلے ایک مکمل کریں یا دوبارہ شیڈول کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 个逾期 toDō 带来了最明显的压力。添加更多事项前，请先完成或重新安排一个。"
          }
        }
      }
    },

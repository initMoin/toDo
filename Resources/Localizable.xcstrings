    "Optional one-time thanks. These purchases do not unlock features." : {
      "comment" : "A description of the benefits of purchasing a one-time thank-you gift.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شكر اختياري لمرة واحدة. لا تفتح هذه المشتريات أي ميزات."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agradecimiento opcional de un solo pago. Estas compras no desbloquean funciones."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वैकल्पिक एकमुश्त धन्यवाद। इन खरीदों से सुविधाएँ अनलॉक नहीं होतीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ringraziamento opzionale una tantum. Questi acquisti non sbloccano funzioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任意の一度限りの応援です。これらの購入で機能は解放されません。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penghargaan sekali sahaja secara pilihan. Pembelian ini tidak membuka ciri."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การขอบคุณแบบซื้อครั้งเดียวที่เลือกได้ การซื้อเหล่านี้ไม่ปลดล็อกฟีเจอร์"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختیاری ایک بار کا شکریہ۔ ان خریداریوں سے کوئی فیچر ان لاک نہیں ہوتا۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选的一次性致谢。这些购买不会解锁功能。"
          }
        }
      }
    },
    "Optional purchases for people who want to support continued development. They never unlock features." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشتريات اختيارية لمن يرغب في دعم استمرار التطوير. لا تفتح أي ميزات."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compras opcionales para quienes quieran apoyar el desarrollo continuo. Nunca desbloquean funciones."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निरंतर विकास का समर्थन करने वाले लोगों के लिए वैकल्पिक खरीदारी। इनसे कोई फीचर अनलॉक नहीं होता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acquisti facoltativi per chi vuole sostenere lo sviluppo continuo. Non sbloccano mai funzionalità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "継続的な開発を支援したい方のための任意購入です。機能がアンロックされることはありません。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pembelian pilihan untuk mereka yang mahu menyokong pembangunan berterusan. Ia tidak membuka sebarang ciri."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การซื้อเพิ่มเติมสำหรับผู้ที่ต้องการสนับสนุนการพัฒนาอย่างต่อเนื่อง การซื้อเหล่านี้ไม่ปลดล็อกฟีเจอร์ใด ๆ"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مسلسل ترقی کی حمایت کرنے والوں کے لیے اختیاری خریداریاں۔ ان سے کوئی فیچر نہیں کھلتا۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "供希望支持持续开发的用户自愿购买，不会解锁任何功能。"
          }
        }
      }
    },
    "Optional purchases that support toDō. They do not unlock additional features." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",

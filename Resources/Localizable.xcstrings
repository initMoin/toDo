        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Googleサインインで安全なブラウザセッションを開けませんでした。もう一度お試しください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log masuk Google tidak dapat membuka sesi pelayar selamat. Cuba lagi."

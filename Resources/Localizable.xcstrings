    "Pick a sound from Files or iCloud Drive. toDō selects it and sends a quick sound test right away." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر صوتًا من الملفات أو iCloud Drive. سيحدده تُدُ ويرسل اختبار صوت سريعًا فورًا."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un sonido desde Archivos o iCloud Drive. toDō lo selecciona y envía una prueba rápida de sonido de inmediato."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files या iCloud Drive से ध्वनि चुनें। toDō उसे चुनकर तुरंत एक छोटा ध्वनि परीक्षण भेजता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli un suono da File o iCloud Drive. toDō lo seleziona e invia subito una prova audio rapida."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ファイル”またはiCloud Driveからサウンドを選びます。toDōがそれを選択し、すぐに短いサウンドテストを送ります。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih bunyi daripada Files atau iCloud Drive. toDō memilihnya dan terus menghantar ujian bunyi ringkas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกเสียงจากไฟล์หรือ iCloud Drive แล้ว toDō จะเลือกเสียงนั้นและส่งการทดสอบเสียงทันที"

    "Stop syncing with iCloud and keep your toDōs on this device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف عن المزامنة معiCloudواحتفظ بمهامك على هذا الجهاز."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deje de sincronizar coniCloudy mantenga sus tareas pendientes en este dispositivo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudके साथ सिंक करना बंद करें और अपने toDōs को इस डिवाइस पर रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interrompi la sincronizzazione coniCloude mantieni le tue cose da fare su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudとの同期を停止し、toDō をこのデバイスに保持します。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berhenti menyegerak denganiClouddan simpan Tugasan anda pada peranti ini."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หยุดการซิงค์กับiCloudและเก็บสิ่งที่ต้องทำของคุณไว้ในอุปกรณ์นี้"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudکے ساتھ مطابقت پذیری بند کریں اور اپنے ٹُڈُوز کو اس ڈیوائس پر رکھیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止与iCloud同步并将您的待办事项保留在此设备上。"
          }
        }
      }
    },
    "Subscriptions renew automatically unless canceled at least 24 hours before the end of the current period. Your Apple Account is charged at confirmation and manages renewal." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتجدد الاشتراكات تلقائيًا ما لم تُلغَ قبل 24 ساعة على الأقل من نهاية الفترة الحالية. يتم تحصيل الرسوم من حساب Apple عند التأكيد، ومنه تُدار عملية التجديد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscriptions renew automatically unless canceled at least 24 hours before the end of the current period. Your Apple Account is charged at confirmation and manages renewal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones se renuevan automáticamente salvo que se cancelen al menos 24 horas antes del final del periodo actual. El cargo se realiza en tu cuenta de Apple al confirmar y la renovación se gestiona desde ella."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सदस्यताएँ अपने-आप नवीनीकृत होती हैं, जब तक कि वर्तमान अवधि समाप्त होने से कम से कम 24 घंटे पहले रद्द न की जाएँ। पुष्टि पर आपके Apple खाते से शुल्क लिया जाता है और वहीं से नवीनीकरण प्रबंधित होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli abbonamenti si rinnovano automaticamente salvo annullamento almeno 24 ore prima della fine del periodo corrente. L'addebito avviene sull'Account Apple alla conferma e il rinnovo si gestisce da lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションは、現在の期間が終了する24時間以上前にキャンセルしない限り自動更新されます。確認時にApple Accountへ請求され、更新もそこで管理されます。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langganan diperbaharui secara automatik melainkan dibatalkan sekurang-kurangnya 24 jam sebelum tempoh semasa tamat. Akaun Apple anda dicaj semasa pengesahan dan mengurus pembaharuan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การสมัครสมาชิกจะต่ออายุอัตโนมัติ เว้นแต่จะยกเลิกอย่างน้อย 24 ชั่วโมงก่อนสิ้นสุดรอบปัจจุบัน บัญชี Apple ของคุณจะถูกเรียกเก็บเงินเมื่อยืนยันและใช้จัดการการต่ออายุ"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سبسکرپشنز خودکار طور پر تجدید ہوتی ہیں جب تک موجودہ مدت ختم ہونے سے کم از کم 24 گھنٹے پہلے منسوخ نہ کی جائیں۔ تصدیق پر آپ کے Apple اکاؤنٹ سے رقم وصول ہوتی ہے اور تجدید وہیں سے منظم ہوتی ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "订阅会自动续订，除非在当前周期结束至少 24 小时前取消。确认购买时将向你的 Apple 帐户收费，续订也由该帐户管理。"
          }
        }
      }
    },

          "stringUnit" : {
            "state" : "translated",
            "value" : "New subscribers receive 1 week free. Renews monthly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nuevos suscriptores reciben 1 semana gratis. Se renueva mensualmente."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नए सदस्यों को 1 सप्ताह निःशुल्क मिलता है। हर महीने नवीनीकरण होता है।"

    "Start with %@. It has a due moment, so it is the best next focus." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ بـ %@. لديه موعد استحقاق، لذلك هو أفضل تركيز تالٍ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza con %@. Tiene un momento de vencimiento, así que es el mejor próximo enfoque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ से शुरू करें। इसकी due समय सीमा है, इसलिए यह सबसे अच्छा अगला फोकस है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizia da %@. Ha una scadenza, quindi è il miglior prossimo focus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@から始めてください。期限があるため、次に集中する最適な項目です。"
          }
        },
        "ms" : {

    "I could not organize that into a toDō. Try describing it again with a clear action." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تنظيم ذلك في تُدُ. حاول وصفه مرة أخرى بإجراء واضح."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pude organizarlo como un toDō. Intenta describirlo de nuevo con una acción clara."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे toDō में व्यवस्थित नहीं किया जा सका। स्पष्ट कार्रवाई के साथ फिर से बताएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sono riuscito a organizzarlo in un toDō. Prova a descriverlo di nuovo con un'azione chiara."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "toDōとして整理できませんでした。明確な行動を含めてもう一度説明してください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perkara itu tidak dapat disusun sebagai toDō. Cuba terangkan semula dengan tindakan yang jelas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถจัดสิ่งนั้นเป็น toDō ได้ ลองอธิบายอีกครั้งโดยระบุการกระทำให้ชัดเจน"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسے ٹُڈُو میں ترتیب نہیں دیا جا سکا۔ واضح عمل کے ساتھ دوبارہ بیان کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法将其整理为 toDō。请用明确的操作重新描述。"
          }
        }
      }

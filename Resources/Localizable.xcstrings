    "Monthly and Annual share one subscription group, so Apple applies at most one introductory offer to an account." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشترك الشهري والسنوي في مجموعة اشتراك واحدة، لذلك تطبق Apple عرضًا تمهيديًا واحدًا كحد أقصى لكل حساب."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monthly and Annual share one subscription group, so Apple applies at most one introductory offer to an account."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensual y Anual comparten un grupo de suscripción, por lo que Apple aplica como máximo una oferta introductoria por cuenta."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मासिक और वार्षिक एक ही सदस्यता समूह में हैं, इसलिए Apple किसी खाते पर अधिकतम एक शुरुआती ऑफ़र लागू करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensile e Annuale condividono un gruppo di abbonamento, quindi Apple applica al massimo un'offerta introduttiva per account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月額と年額は同じサブスクリプショングループに属するため、Appleがアカウントに適用する導入オファーは最大1つです。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulanan dan Tahunan berkongsi satu kumpulan langganan, jadi Apple menggunakan paling banyak satu tawaran pengenalan bagi setiap akaun."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แบบรายเดือนและรายปีอยู่ในกลุ่มการสมัครสมาชิกเดียวกัน Apple จึงใช้ข้อเสนอเริ่มต้นได้สูงสุดหนึ่งรายการต่อบัญชี"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماہانہ اور سالانہ ایک ہی سبسکرپشن گروپ میں ہیں، اس لیے Apple ہر اکاؤنٹ پر زیادہ سے زیادہ ایک ابتدائی پیشکش لاگو کرتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "月度和年度订阅共用一个订阅组，因此 Apple 对每个账户最多应用一项首购优惠。"
          }
        }
      }
    },
    "Monthly, Annual, and Lifetime unlock the same toDō+ membership, including unlimited personal Collab invitations." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {

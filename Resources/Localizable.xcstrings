    "Google sign-in could not open the secure browser session. Try again." : {
      "comment" : "Error message when Google sign-in fails to start a browser session.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر على تسجيل الدخول عبر Google فتح جلسة المتصفح الآمنة. حاول مرة أخرى."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google no pudo abrir la sesión segura del navegador. Inténtalo de nuevo."

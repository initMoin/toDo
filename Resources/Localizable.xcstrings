        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فائلز یا iCloud Drive سے آواز منتخب کریں۔ toDō اسے منتخب کر کے فوراً ایک مختصر آواز ٹیسٹ بھیجتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

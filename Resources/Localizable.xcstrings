    "Permanently deletes personal toDōs and NanoDos without deleting your account, tags, or purchases." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف toDōs وNanoDos الشخصية نهائيًا دون حذف حسابك أو وسومك أو مشترياتك."
          }
        },
        "es" : {
          "stringUnit" : {

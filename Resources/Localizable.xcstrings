    "This permanently deletes all items in the trash. This cannot be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف هذا كل العناصر في سلة المهملات نهائيًا. لا يمكن التراجع عن هذا."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina permanentemente todos los elementos de la papelera. Esto no se puede deshacer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह ट्रैश में मौजूद सभी आइटम को स्थायी रूप से हटा देता है। इसे असंपादित नहीं किया जा सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina definitivamente tutti gli elementi nel cestino. Questa azione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゴミ箱内のすべての項目を完全に削除します。この操作は取り消せません。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini memadam semua item dalam sampah secara kekal. Tindakan ini tidak boleh dibuat asal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดำเนินการนี้จะลบรายการทั้งหมดในถังขยะอย่างถาวรและไม่สามารถย้อนกลับได้"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ ردی کے تمام آئٹمز مستقل طور پر حذف کرتا ہے۔ یہ واپس نہیں ہو سکتا۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除垃圾箱中的所有项目。此操作无法撤消。"
          }
        }
      }
    },
    "This permanently deletes every completed and archived toDō." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف هذا كل تُدُ مكتمل ومؤرشف نهائيًا."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina permanentemente todas las tareas pendientes completadas y archivadas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह प्रत्येक पूर्ण और संग्रहीत toDō को स्थायी रूप से हटा देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina definitivamente ogni toDō completato e archiviato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完了およびアーカイブ済みのtoDōをすべて完全に削除します。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini memadam setiap toDō selesai dan diarkibkan secara kekal."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบ toDō ที่เสร็จแล้วและเก็บถาวรทั้งหมดอย่างถาวร"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ ہر مکمل اور آرکائیو شدہ ٹُڈُو مستقل طور پر حذف کرتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除每个已完成并存档的待办事项。"
          }
        }
      }
    },
    "This permanently deletes every personal toDō and NanoDo on this device and synced account. Your account, tags, preferences, purchases, and shared lists stay intact." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا إلى حذف كل toDō وNanoDo شخصي نهائيًا من هذا الجهاز والحساب المتزامن. سيبقى حسابك ووسومك وتفضيلاتك ومشترياتك وقوائمك المشتركة كما هي."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina permanentemente cada toDō y NanoDo personal de este dispositivo y de la cuenta sincronizada. Tu cuenta, etiquetas, preferencias, compras y listas compartidas permanecen intactas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह इस डिवाइस और सिंक किए गए खाते से हर निजी toDō और NanoDo को हमेशा के लिए मिटा देता है। आपका खाता, टैग, प्राथमिकताएँ, खरीदारी और साझा सूचियाँ सुरक्षित रहती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione elimina definitivamente ogni toDō e NanoDo personale dal dispositivo e dall’account sincronizzato. Account, tag, preferenze, acquisti ed elenchi condivisi restano intatti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスと同期アカウントにある個人のtoDōとNanoDoをすべて完全に削除します。アカウント、タグ、設定、購入内容、共有リストは維持されます。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini memadam secara kekal setiap toDō dan NanoDo peribadi pada peranti ini dan akaun disegerakkan. Akaun, tag, pilihan, pembelian dan senarai dikongsi anda kekal utuh."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การดำเนินการนี้จะลบ toDō และ NanoDo ส่วนตัวทั้งหมดออกจากอุปกรณ์นี้และบัญชีที่ซิงค์อย่างถาวร บัญชี แท็ก การตั้งค่า การซื้อ และรายการที่แชร์จะยังคงอยู่"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ اس ڈیوائس اور مطابقت پذیر اکاؤنٹ سے ہر ذاتی toDō اور NanoDo کو مستقل طور پر حذف کر دیتا ہے۔ آپ کا اکاؤنٹ، ٹیگز، ترجیحات، خریداریاں اور مشترکہ فہرستیں برقرار رہتی ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会永久删除此设备和同步账户中的所有个人 toDō 和 NanoDo。你的账户、标签、偏好设置、购买项目和共享列表保持不变。"
          }
        }
      }
    },

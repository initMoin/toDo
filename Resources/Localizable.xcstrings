    "Keep it on this device, or share it across signed-in devices through toDō." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفظ بها على هذا الجهاز، أو شاركها عبر الأجهزة التي سجّلت الدخول من خلال toDō."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep it on this device, or share it across signed-in devices through toDō."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guárdala en este dispositivo o compártela entre tus dispositivos con sesión iniciada mediante toDō."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसे इसी डिवाइस पर रखें या toDō के ज़रिए साइन-इन किए गए डिवाइसों पर साझा करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tientila su questo dispositivo oppure condividila tra i dispositivi con accesso tramite toDō."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスに保存するか、toDōを通じてサインイン済みのデバイス間で共有します。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpannya pada peranti ini atau kongsikannya merentas peranti yang dilog masuk melalui toDō."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เก็บไว้ในอุปกรณ์นี้หรือแชร์ไปยังอุปกรณ์ที่ลงชื่อเข้าใช้ผ่าน toDō"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسے اسی ڈیوائس پر رکھیں یا toDō کے ذریعے سائن اِن آلات پر شیئر کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留在此设备上，或通过 toDō 在已登录设备之间共享。"
          }
        }
      }
    },

    "Debug simulator only. This does not ship in Release or device builds." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لمحاكي تصحيح الأخطاء فقط. لا يظهر هذا في إصدارات النشر أو الأجهزة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo para el simulador de depuración. No se incluye en versiones de distribución ni de dispositivo."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल डिबग सिम्युलेटर के लिए। यह रिलीज़ या डिवाइस बिल्ड में शामिल नहीं होता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo per il simulatore di debug. Non viene incluso nelle build Release o per dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デバッグ用シミュレータ専用です。リリース版や実機ビルドには含まれません。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk simulator nyahpepijat sahaja. Ini tidak disertakan dalam binaan keluaran atau peranti."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สำหรับโปรแกรมจำลองแบบดีบักเท่านั้น ข้อความนี้จะไม่รวมอยู่ในรุ่นเผยแพร่หรือรุ่นสำหรับอุปกรณ์"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صرف ڈیبگ سمیولیٹر کے لیے۔ یہ ریلیز یا ڈیوائس بلڈز میں شامل نہیں ہوتا۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅用于调试模拟器。发布版本和设备构建中不会包含此内容。"
          }
        }
      }
    },

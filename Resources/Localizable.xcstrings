        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "toDō का समर्थन करने वाली वैकल्पिक खरीदारियाँ। ये अतिरिक्त सुविधाएँ अनलॉक नहीं करतीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

    "Describe a complete toDō naturally. The app organizes its details and asks a short follow-up only when needed." : {
      "comment" : "Description of the intent that organizes the details of a toDō.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صِف toDō كاملة بشكل طبيعي. ينظّم التطبيق تفاصيلها ويطرح سؤال متابعة قصيرًا عند الحاجة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe una toDō completa de forma natural. La app organiza sus detalles y hace una breve pregunta de seguimiento cuando es necesario."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक पूर्ण toDō को स्वाभाविक रूप से बताएँ। ऐप उसके विवरण व्यवस्थित करता है और ज़रूरत होने पर एक छोटा पूरक प्रश्न पूछता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descrivi una toDō completa in modo naturale. L'app ne organizza i dettagli e fa una breve domanda di chiarimento solo quando serve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成したtoDōを自然に説明してください。アプリが詳細を整理し、必要なときだけ短い確認質問をします。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huraikan toDō lengkap secara semula jadi. Aplikasi menyusun butirannya dan bertanya soalan ringkas jika perlu."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อธิบาย toDō ให้ครบถ้วนอย่างเป็นธรรมชาติ แอปจะจัดระเบียบรายละเอียดและถามคำถามสั้น ๆ เมื่อจำเป็น"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک مکمل toDō کو قدرتی انداز میں بیان کریں۔ ایپ اس کی تفصیلات ترتیب دیتی ہے اور ضرورت پڑنے پر مختصر سوال پوچھتی ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自然地描述一个完整的 toDō。应用会整理其详细信息，并仅在需要时提出简短的后续问题。"
          }
        }
      }
    },
    "Describe a toDō naturally and organize its title, schedule, reminder, notes, tags, and steps." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صِف تُدُ بطريقتك ليتم تنظيم عنوانه وموعده وتذكيره وملاحظاته ووسومه وخطواته."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe un toDō con naturalidad y organiza su título, horario, recordatorio, notas, etiquetas y pasos."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "toDō को सहज रूप से बताएँ और उसका शीर्षक, समय, रिमाइंडर, नोट्स, टैग और चरण व्यवस्थित करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descrivi un toDō in modo naturale e organizzane titolo, programma, promemoria, note, tag e passaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "toDōを自然に説明して、タイトル、予定、リマインダー、メモ、タグ、手順を整理します。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terangkan toDō secara semula jadi dan susun tajuk, jadual, peringatan, nota, tag serta langkahnya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อธิบาย toDō อย่างเป็นธรรมชาติ แล้วจัดระเบียบชื่อ กำหนดเวลา การเตือน โน้ต แท็ก และขั้นตอน"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ٹُڈُو کو فطری انداز میں بیان کریں اور اس کا عنوان، شیڈول، یاددہانی، نوٹس، ٹیگز اور مراحل ترتیب دیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自然地描述一个 toDō，并整理其标题、日程、提醒、备注、标签和步骤。"
          }
        }
      }
    },
    "Describe the toDō, including any due date, reminder, recurrence, tags, NanoDos, notes, or location." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صِف toDō، بما في ذلك أي تاريخ استحقاق أو تذكير أو تكرار أو علامات أو NanoDos أو ملاحظات أو موقع."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Describe la toDō, incluyendo cualquier fecha límite, recordatorio, repetición, etiqueta, NanoDo, nota o ubicación."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "toDō का वर्णन करें, जिसमें नियत तारीख, रिमाइंडर, दोहराव, टैग, NanoDos, नोट्स या स्थान शामिल हो।"

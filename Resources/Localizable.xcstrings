    "Invitation sent. If the address is not registered yet, it will remain pending until they join toDō." : {
      "comment" : "A notice displayed when a user is invited to a collaboration.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم إرسال الدعوة. إذا لم يكن العنوان مسجلاً بعد، فستبقى معلقة حتى ينضم المستخدم إلى toDō."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invitación enviada. Si la dirección aún no está registrada, quedará pendiente hasta que se una a toDō."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आमंत्रण भेजा गया। यदि पता अभी पंजीकृत नहीं है, तो उपयोगकर्ता के toDō में शामिल होने तक यह लंबित रहेगा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invito inviato. Se l'indirizzo non è ancora registrato, resterà in sospeso finché l'utente non si unirà a toDō."
          }
        },
        "ja" : {
          "stringUnit" : {

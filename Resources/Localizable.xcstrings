    "Choose where your current profile image should be available. You can change this later if your devices or sync setup changes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر مكان إتاحة صورة ملفك الشخصي الحالية. يمكنك تغيير ذلك لاحقًا إذا تغيّرت أجهزتك أو إعداد المزامنة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige dónde debe estar disponible tu imagen de perfil. Puedes cambiarlo más adelante si cambian tus dispositivos o la configuración de sincronización."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनें कि आपका वर्तमान प्रोफ़ाइल चित्र कहाँ उपलब्ध होना चाहिए। आपके डिवाइस या सिंक सेटअप बदलने पर इसे बाद में बदला जा सकता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli dove deve essere disponibile la tua immagine del profilo. Puoi cambiarlo in seguito se cambiano i tuoi dispositivi o la configurazione della sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のプロフィール画像を利用できる場所を選択します。デバイスや同期設定が変わった場合は、後から変更できます。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih tempat gambar profil semasa anda patut tersedia. Anda boleh menukarnya kemudian jika peranti atau tetapan penyegerakan berubah."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกตำแหน่งที่รูปโปรไฟล์ปัจจุบันควรใช้งานได้ คุณเปลี่ยนได้ภายหลังหากอุปกรณ์หรือการตั้งค่าการซิงค์เปลี่ยนไป"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منتخب کریں کہ آپ کی موجودہ پروفائل تصویر کہاں دستیاب ہو۔ آلات یا مطابقت پذیری کی ترتیبات بدلنے پر آپ اسے بعد میں تبدیل کر سکتے ہیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择当前头像的可用范围。如果设备或同步设置发生变化，之后仍可更改。"
          }
        }
      }
    },

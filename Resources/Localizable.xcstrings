    "%@ toDōs are due today. Start with the one that unlocks the most progress." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستحق %@ من مهام toDō اليوم. ابدأ بالمهمة التي تفتح المجال لأكبر قدر من التقدم."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ toDōs vencen hoy. Empieza por el que permita avanzar más."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ toDō आज देय हैं। उससे शुरू करें जो सबसे अधिक प्रगति का रास्ता खोले।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ toDō scadono oggi. Inizia da quello che sblocca più progressi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日が期限のtoDōが%@件あります。最も進展につながるものから始めましょう。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ toDō perlu disiapkan hari ini. Mulakan dengan yang membuka paling banyak kemajuan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "toDō %@ รายการครบกำหนดวันนี้ เริ่มจากรายการที่ช่วยให้คืบหน้าได้มากที่สุด"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ toDō آج واجب الادا ہیں۔ اس کام سے شروع کریں جو سب سے زیادہ پیش رفت کھولتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天有 %@ 个 toDō 到期。先从最能推动进展的事项开始。"
          }
        }
      }
    },
    "%@ toDōs changed on more than one device. Choose which versions to keep." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",

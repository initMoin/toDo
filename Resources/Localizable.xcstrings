    "Your workload is steady. Choose one active toDō and move it forward." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عبء عملك مستقر. اختر مهمة toDō نشطة وادفعها إلى الأمام."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu carga de trabajo está estable. Elige un toDō activo y hazlo avanzar."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका कार्यभार स्थिर है। एक सक्रिय toDō चुनें और उसे आगे बढ़ाएँ।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il carico di lavoro è stabile. Scegli un toDō attivo e portalo avanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作業量は安定しています。進行中のtoDōを1つ選んで前に進めましょう。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beban kerja anda stabil. Pilih satu toDō aktif dan gerakkannya ke hadapan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ภาระงานของคุณคงที่ เลือก toDō ที่กำลังทำอยู่หนึ่งรายการแล้วเดินหน้าต่อ"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا کام مستحکم ہے۔ ایک فعال toDō منتخب کریں اور اسے آگے بڑھائیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的工作量较为稳定。选择一个进行中的 toDō 并推动它向前。"
          }
        }
      }
    },

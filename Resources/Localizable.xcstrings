    "Free accounts can invite up to %lld users. Remove one or choose toDō+ to invite someone else." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للحسابات المجانية دعوة ما يصل إلى %lld من المستخدمين. أزل مستخدمًا أو اختر toDō+ لدعوة شخص آخر."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las cuentas gratuitas pueden invitar hasta %lld usuarios. Elimina uno o elige toDō+ para invitar a otra persona."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मुफ़्त खाते अधिकतम %lld उपयोगकर्ताओं को आमंत्रित कर सकते हैं। किसी एक को हटाएँ या किसी और को आमंत्रित करने के लिए toDō+ चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli account gratuiti possono invitare fino a %lld utenti. Rimuovine uno o scegli toDō+ per invitare un'altra persona."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料アカウントが招待できるユーザーは%lld人までです。1人削除するか、toDō+を選んで別のユーザーを招待してください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akaun percuma boleh menjemput sehingga %lld pengguna. Alih keluar seorang atau pilih toDō+ untuk menjemput orang lain."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บัญชีฟรีเชิญผู้ใช้ได้สูงสุด %lld คน ให้นำหนึ่งคนออกหรือเลือก toDō+ เพื่อเชิญคนอื่น"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفت اکاؤنٹس زیادہ سے زیادہ %lld صارفین کو مدعو کر سکتے ہیں۔ کسی ایک کو ہٹائیں یا کسی اور کو مدعو کرنے کے لیے toDō+ منتخب کریں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费帐户最多可邀请 %lld 位用户。移除一位用户，或选择 toDō+ 以邀请其他人。"
          }
        }
      }
    },

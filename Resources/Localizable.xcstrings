    "Let toDō help summarize, organize, and surface what matters using Apple Intelligence when available." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دع toDō يساعدك في التلخيص والتنظيم وإبراز المهم باستخدام Apple Intelligence عند توفره."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja que toDō te ayude a resumir, organizar y destacar lo importante con Apple Intelligence cuando esté disponible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उपलब्ध होने पर Apple Intelligence से toDō को सारांश, आयोजन और महत्वपूर्ण चीज़ें दिखाने में मदद करने दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascia che toDō aiuti a riassumere, organizzare e far emergere ciò che conta usando Apple Intelligence quando disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用可能な場合、Apple Intelligenceを使ってtoDōが要約、整理、重要事項の提示を手伝います。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biarkan toDō membantu meringkaskan, mengatur, dan menonjolkan perkara penting menggunakan Apple Intelligence apabila tersedia."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ให้ toDō ช่วยสรุป จัดระเบียบ และยกสิ่งสำคัญขึ้นมาโดยใช้ Apple Intelligence เมื่อพร้อมใช้งาน"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دستیاب ہونے پر Apple Intelligence کے ذریعے toDō کو خلاصہ، ترتیب، اور اہم چیزیں سامنے لانے میں مدد کرنے دیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在可用时，让 toDō 使用 Apple Intelligence 帮你总结、整理并呈现重要事项。"
          }
        }
      }
    },

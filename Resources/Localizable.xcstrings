    "Offer codes may provide promotional access. StoreKit checks eligibility and applies the configured offer." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد توفر رموز العروض وصولًا ترويجيًا. تتحقق StoreKit من الأهلية وتطبق العرض المُعد."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offer codes may provide promotional access. StoreKit checks eligibility and applies the configured offer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los códigos de oferta pueden proporcionar acceso promocional. StoreKit comprueba la elegibilidad y aplica la oferta configurada."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑफ़र कोड प्रचारात्मक पहुँच दे सकते हैं। StoreKit पात्रता जाँचकर कॉन्फ़िगर किया गया ऑफ़र लागू करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I codici offerta possono fornire accesso promozionale. StoreKit verifica l'idoneità e applica l'offerta configurata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オファーコードでプロモーションを利用できます。StoreKitが対象資格を確認し、設定されたオファーを適用します。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod tawaran mungkin memberikan akses promosi. StoreKit menyemak kelayakan dan menggunakan tawaran yang dikonfigurasikan."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "รหัสข้อเสนออาจให้สิทธิ์โปรโมชั่น StoreKit จะตรวจสอบสิทธิ์และใช้ข้อเสนอที่กำหนดไว้"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آفر کوڈز پروموشنل رسائی دے سکتے ہیں۔ StoreKit اہلیت چیک کر کے ترتیب دی گئی آفر لاگو کرتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优惠代码可能提供促销权益。StoreKit 会检查资格并应用已配置的优惠。"
          }
        }
      }
    },

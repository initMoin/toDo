          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他のユーザーと使う共有スペースに名前を付けます。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namakan ruang bersama yang ingin digunakan dengan pengguna lain."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตั้งชื่อพื้นที่แชร์ที่คุณต้องการใช้กับผู้ใช้อื่น"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس مشترکہ جگہ کا نام رکھیں جسے آپ دوسرے صارفین کے ساتھ استعمال کرنا چاہتے ہیں۔"

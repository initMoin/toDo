    "New subscribers receive 1 week free. Renews monthly." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحصل المشتركون الجدد على أسبوع مجاني. يتجدد شهريًا."
          }
        },

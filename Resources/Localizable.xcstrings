    "Make space for what matters, shape the work, and carry it with you across your devices." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وفّر مساحة لما يهم، وشكّل العمل، وخذه معك عبر أجهزتك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make space for what matters, shape the work, and carry it with you across your devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz espacio para lo importante, da forma al trabajo y llévalo contigo en todos tus dispositivos."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो मायने रखता है उसके लिए जगह बनाएँ, काम को आकार दें और उसे अपने सभी डिवाइस पर साथ रखें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai spazio a ciò che conta, dai forma al lavoro e portalo con te su tutti i tuoi dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大切なことのための余白をつくり、作業を整え、どのデバイスでも持ち歩けます。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri ruang untuk perkara penting, susun kerja dan bawanya bersama anda merentas peranti."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สร้างพื้นที่ให้สิ่งสำคัญ จัดรูปแบบงาน และพกพาไปกับคุณในทุกอุปกรณ์"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اہم کام کے لیے جگہ بنائیں، کام کو ترتیب دیں اور اسے اپنے تمام آلات پر ساتھ رکھیں۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为重要的事情留出空间，理清工作，并在所有设备上随身使用。"
          }
        }
      }
    },
    "Making sure tags and toDōs stay linked correctly." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التأكد من بقاء العلامات والمهام مرتبطة بشكل صحيح."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegurarse de que las etiquetas y las tareas pendientes permanezcan vinculadas correctamente."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सुनिश्चित करना कि टैग और toDōs सही ढंग से जुड़े रहें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assicurati che tag e cose da fare rimangano collegati correttamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タグと toDō が正しくリンクされた状態に保たれるようにします。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memastikan teg dan Tugasan kekal dipautkan dengan betul."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบให้แน่ใจว่าแท็กและสิ่งที่ต้องทำเชื่อมโยงกันอย่างถูกต้อง"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس بات کو یقینی بنانا کہ ٹیگز اور ٹُڈُوز صحیح طریقے سے جڑے رہیں۔"

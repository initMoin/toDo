    "Settings controls sync, notification behavior, appearance, and whether removing a toDō archives or trashes it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتحكم الإعدادات في المزامنة، سلوك الإشعارات، المظهر، وما إذا كانت إزالة toDō تؤرشفه أو ترسله إلى المهملات."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustes controla la sincronización, las notificaciones, la apariencia y si al quitar un toDō se archiva o se envía a la papelera."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settings sync, notification behavior, appearance, और toDō हटाने पर archive या trash होने का निर्णय संभालता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostazioni controlla sincronizzazione, notifiche, aspetto e se la rimozione di un toDō lo archivia o lo sposta nel cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定では、同期、通知の動作、外観、toDōを削除時にアーカイブするかゴミ箱へ移すかを管理します。"

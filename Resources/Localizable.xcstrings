    "If the test sounds right, future reminders use that sound." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا بدا الاختبار صحيحًا، فستستخدم التذكيرات القادمة هذا الصوت."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la prueba suena bien, los próximos recordatorios usarán ese sonido."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि परीक्षण सही सुनाई देता है, तो आगे के रिमाइंडर वही ध्वनि उपयोग करेंगे।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se la prova suona corretta, i prossimi promemoria useranno quel suono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テストの音が正しければ、今後のリマインダーでそのサウンドが使われます。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika ujian berbunyi betul, peringatan akan datang menggunakan bunyi itu."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ถ้าการทดสอบฟังดูถูกต้อง การเตือนครั้งต่อไปจะใช้เสียงนั้น"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اگر ٹیسٹ درست سنائی دے تو آئندہ یاد دہانیاں یہی آواز استعمال کریں گی۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果测试声音正确，之后的提醒将使用该声音。"
          }
        }
      }
    },
    "If you already used %@ on another device, choose the existing-destination option first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كنت قد استخدمت %@ على جهاز آخر، فاختر خيار الوجهة الموجودة أولًا."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ya usaste %@ en otro dispositivo, elige primero la opción de destino existente."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर आपने किसी दूसरे डिवाइस पर %@ पहले से उपयोग किया है, तो पहले मौजूदा गंतव्य वाला विकल्प चुनें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se hai già usato %@ su un altro dispositivo, scegli prima l’opzione della destinazione esistente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のデバイスで %@ をすでに使っている場合は、先に既存の保存先を使うオプションを選んでください。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika anda sudah menggunakan %@ pada peranti lain, pilih pilihan destinasi sedia ada dahulu."
          }

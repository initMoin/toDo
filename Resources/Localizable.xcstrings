          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "อธิบาย toDō รวมถึงวันครบกำหนด การเตือน การทำซ้ำ แท็ก NanoDos โน้ต หรือตำแหน่ง"

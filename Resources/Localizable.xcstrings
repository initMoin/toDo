    "Today has enough shape to choose a focused next move." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اليوم واضح بما يكفي لاختيار خطوة مركزة تالية."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy tiene suficiente forma para elegir el siguiente paso con enfoque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज इतना स्पष्ट है कि अगला केंद्रित कदम चुना जा सके।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi ha abbastanza struttura per scegliere una prossima mossa mirata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は次の集中すべき一手を選べるだけの形があります。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hari ini cukup jelas untuk memilih langkah fokus seterusnya."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "วันนี้มีโครงพอให้เลือกก้าวถัดไปอย่างมีสมาธิ"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آج اتنی وضاحت ہے کہ اگلا مرکوز قدم چنا جا سکے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天已经足够清晰，可以选择一个专注的下一步。"
          }
        }
      }
    },
    "Today has scheduled work ready for focused attention." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اليوم لديه عمل مجدول جاهز لتركيزك."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy hay trabajo programado listo para atención enfocada."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज निर्धारित कार्य केंद्रित ध्यान के लिए तैयार है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oggi c’è lavoro programmato pronto per attenzione mirata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は集中して取り組む予定作業があります。"
          }
        },

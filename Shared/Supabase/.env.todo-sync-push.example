# Supabase provides SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY automatically to Edge Functions.
# If your CLI warns that SUPABASE_SERVICE_ROLE_KEY is skipped, that is expected.

APNS_TEAM_ID=YOUR_APPLE_TEAM_ID
APNS_BUNDLE_ID=dev.iamshift.ToDo-TaskManagement

# Xcode/debug installs use sandbox APNs tokens.
APNS_SANDBOX_KEY_ID=YOUR_SANDBOX_APNS_KEY_ID
APNS_SANDBOX_PRIVATE_KEY_BASE64=BASE64_ENCODED_SANDBOX_P8

# TestFlight/App Store installs use production APNs tokens.
APNS_PRODUCTION_KEY_ID=YOUR_PRODUCTION_APNS_KEY_ID
APNS_PRODUCTION_PRIVATE_KEY_BASE64=BASE64_ENCODED_PRODUCTION_P8

# Fallback only if a token row has no environment. Token rows should normally decide this.
APNS_ENVIRONMENT=sandbox

# Leave unset or false in production. Set true only while diagnosing APNs delivery.
TODO_SYNC_PUSH_DEBUG_LOGS=false

# Keep push outbox rows for this many days.
SYNC_PUSH_EVENT_RETENTION_DAYS=7
